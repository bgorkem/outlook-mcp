{
  "name": "@bgorkem/outlook-mcp",
  "version": "0.1.3",
  "description": "MCP server for personal Microsoft account mailboxes (Outlook.com / Hotmail / Live) via Microsoft Graph",
  "type": "module",
  "license": "MIT",
  "bin": {
    "outlook-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "^3.2.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "outlook",
    "microsoft-graph",
    "email",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bgorkem/outlook-mcp.git"
  },
  "homepage": "https://github.com/bgorkem/outlook-mcp#readme",
  "bugs": {
    "url": "https://github.com/bgorkem/outlook-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "bgorkem"
}
